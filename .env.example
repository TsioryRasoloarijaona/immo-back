# Gabarit pour `docker run --env-file .env`. Copier en `.env` et renseigner les
# valeurs vides depuis la run configuration IntelliJ (Run > Edit Configurations).
#
# ATTENTION au format : docker lit ce fichier litteralement, sans passer par un
# shell. Ne PAS entourer les valeurs de guillemets (ils feraient partie de la
# valeur) et ne PAS mettre de commentaire en fin de ligne.

# --- Base de donnees ---------------------------------------------------------
# application.properties fige le port a 1433. L'instance SQL Server locale ecoute
# sur 49687, donc on court-circuite l'URL entiere : SPRING_DATASOURCE_URL est
# prioritaire sur spring.datasource.url (relaxed binding Spring Boot).
# host.docker.internal = la machine hote vue depuis le conteneur ; 127.0.0.1
# designerait le conteneur lui-meme.
SPRING_DATASOURCE_URL=jdbc:sqlserver://host.docker.internal:49687;databaseName=yesRemsProd;encrypt=true;trustServerCertificate=true
DB_HOST=host.docker.internal
DB_NAME=yesRemsProd
DB_USER=
DB_PWD=

# --- Auth --------------------------------------------------------------------
JWT_SECRET=
# En HTTP local le navigateur refuse un cookie Secure : le login repond 200 puis
# tout appel suivant renvoie 401. A laisser a true des que le VPS est en HTTPS.
APP_JWT_COOKIE_SECURE=false

# --- Stockage objet (MinIO) --------------------------------------------------
S3_ENDPOINT=https://s3.tsiory.tech
S3_BUCKET=immo-back
# N'affecte que les NOUVEAUX depots (CleStockage.construire) ; les lectures
# suivent le StorageKey deja enregistre dans AppFileObject. 'prod' garde les
# nouvelles cles alignees sur les 3 138 objets migres.
S3_PREFIX=prod
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
