# Secrets de la migration S3.
#
#   cp .env.example .env    puis renseigner les valeurs
#
# `.env` est ignoré par git (voir ../.gitignore) — ne JAMAIS le committer, ne jamais
# renommer .env.example en y laissant de vraies valeurs.
#
# Toute variable déjà présente dans l'environnement prime sur ce fichier : sur le
# serveur de production, exporter les secrets suffit, sans toucher au fichier.

# --- Base SQL Server (lecture seule sur le schéma legacy) ---
DB_PWD=

# --- MinIO / S3 ---
# Utiliser un compte de service dédié, limité au seul bucket de la migration.
# Ne jamais utiliser les identifiants root MinIO (MINIO_ROOT_USER / _PASSWORD).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optionnels — équivalents aux options de ligne de commande correspondantes.
# S3_ENDPOINT=https://minio.exemple.com
# S3_REGION=us-east-1
# DB_HOST=localhost,49687
# DB_NAME=yesRems
# DB_USER=tsix
