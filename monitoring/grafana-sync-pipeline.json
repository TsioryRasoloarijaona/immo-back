{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "La source Prometheus qui scrape /actuator/prometheus du backend",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "Pipeline de synchronisation (OMRAN 115 -> copie)",
  "uid": "sync-pipeline",
  "tags": ["immo-back", "synchro"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Age du dernier cycle",
      "description": "time() - sync_last_success_timestamp_seconds. Rouge = pipeline muet.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 180 },
            { "color": "red", "value": 360 }
          ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "time() - max(sync_last_success_timestamp_seconds)", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tables en echec (dernier cycle)",
      "description": "sync_tables_failed",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "max(sync_tables_failed)", "instant": true }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Version CT source",
      "description": "sync_source_version au dernier cycle",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "max(sync_source_version)", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Retard max (toutes tables)",
      "description": "max(sync_watermark_lag). 0 = tout est importe.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 50 }
          ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "max(sync_watermark_lag)", "instant": true }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Retard par table (sync_watermark_lag)",
      "description": "version source - filigrane copie. 0 = a jour.",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "color-background" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 50 }
          ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "table" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "auto" } } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Value", "desc": true } ] },
      "targets": [
        { "refId": "A", "expr": "sync_watermark_lag", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }, "renameByName": { "table": "Table", "Value": "Retard" } } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Debit : lignes fusionnees / supprimees (par s)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "rate(sync_rows_merged_total[5m])", "legendFormat": "fusionnees/s" },
        { "refId": "B", "expr": "rate(sync_rows_deleted_total[5m])", "legendFormat": "supprimees/s" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Duree moyenne d'un cycle",
      "description": "rate(_sum)/rate(_count) : le Timer n'a pas d'histogramme, donc moyenne (pas p95).",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "rate(sync_cycle_duration_seconds_sum[5m]) / rate(sync_cycle_duration_seconds_count[5m])", "legendFormat": "duree moyenne" }
      ]
    }
  ]
}
