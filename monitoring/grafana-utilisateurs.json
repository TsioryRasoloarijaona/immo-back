{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "La source Prometheus qui scrape immo-back sur :9091/actuator/prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Qui utilise Arpent, quand, et quelles routes. Source : arpent_utilisateur_requetes_total et arpent_utilisateur_derniere_activite_secondes (FEATURE-suivi-utilisateurs.md). Seuls login, type d'accès, méthode et modèle de route sont collectés.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["immo-back", "arpent", "utilisateurs"],
  "templating": {
    "list": [
      {
        "name": "utilisateur", "label": "Utilisateur", "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(arpent_utilisateur_requetes_total, utilisateur)", "refId": "V" },
        "definition": "label_values(arpent_utilisateur_requetes_total, utilisateur)",
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "type", "label": "Accès", "type": "custom",
        "query": "session,cle_api", "multi": true, "includeAll": true, "allValue": ".*",
        "current": { "selected": true, "text": ["session"], "value": ["session"] },
        "options": [
          { "selected": true, "text": "session", "value": "session" },
          { "selected": false, "text": "cle_api", "value": "cle_api" }
        ]
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "browser",
  "title": "Arpent — Utilisateurs",
  "uid": "arpent-utilisateurs",
  "panels": [
    {
      "type": "stat", "title": "Connectés maintenant (15 min)", "id": 1,
      "description": "Utilisateurs dont la dernière requête date de moins de 15 minutes. Le flux de notifications (onglet ouvert) ne compte pas comme activité.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "count((time() - arpent_utilisateur_derniere_activite_secondes{type=~\"$type\"}) < 900) or vector(0)", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Actifs sur la période", "id": 2,
      "description": "Utilisateurs ayant fait au moins une requête sur la période choisie en haut à droite.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "count(max by (utilisateur) (max_over_time(arpent_utilisateur_derniere_activite_secondes{type=~\"$type\"}[$__range])) >= ${__from:date:seconds}) or vector(0)", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "timeseries", "title": "Utilisateurs actifs dans le temps (fenêtre 15 min)", "id": 3,
      "description": "À chaque instant, nombre d'utilisateurs dont la dernière requête date de moins de 15 minutes.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "count((time() - arpent_utilisateur_derniere_activite_secondes{type=~\"$type\"}) < 900) or vector(0)", "legendFormat": "actifs", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "type": "table", "title": "Dernière activité par utilisateur", "id": 4,
      "description": "Dernière requête de chaque utilisateur vue sur la période (flux de notifications exclu). Un utilisateur absent n'a rien fait sur la période — ou utilise OMRAN.",
      "gridPos": { "h": 10, "w": 10, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "max by (utilisateur, type) (max_over_time(arpent_utilisateur_derniere_activite_secondes{type=~\"$type\"}[$__range])) * 1000", "refId": "A", "instant": true, "format": "table" },
        { "expr": "time() - max by (utilisateur, type) (max_over_time(arpent_utilisateur_derniere_activite_secondes{type=~\"$type\"}[$__range]))", "refId": "B", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "utilisateur": "Utilisateur", "type": "Accès", "Value #A": "Dernière activité", "Value #B": "Il y a" }
        } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Il y a", "desc": false }] } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Dernière activité" }, "properties": [{ "id": "unit", "value": "dateTimeAsLocal" }] },
          { "matcher": { "id": "byName", "options": "Il y a" }, "properties": [
            { "id": "unit", "value": "s" },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "red", "value": 259200 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries", "title": "Requêtes par utilisateur", "id": 5,
      "description": "Volume de requêtes par utilisateur (flux de notifications exclu). Un compteur qui vient d'apparaître perd sa toute première requête : ordre de grandeur, pas comptabilité.",
      "gridPos": { "h": 10, "w": 14, "x": 10, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (utilisateur) (increase(arpent_utilisateur_requetes_total{utilisateur=~\"$utilisateur\", type=~\"$type\", uri!=\"/api/notifications/flux\"}[$__rate_interval]))", "legendFormat": "{{utilisateur}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "table", "title": "Routes appelées par utilisateur (période)", "id": 6,
      "description": "Nombre d'appels par utilisateur, méthode et modèle de route sur la période ({id} = un identifiant, jamais sa valeur). Filtrer avec la variable Utilisateur.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "topk(200, round(sum by (utilisateur, methode, uri) (increase(arpent_utilisateur_requetes_total{utilisateur=~\"$utilisateur\", type=~\"$type\"}[$__range]))) > 0)", "refId": "A", "instant": true, "format": "table" }],
      "transformations": [
        { "id": "organize", "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "utilisateur": 0, "methode": 1, "uri": 2, "Value": 3 },
            "renameByName": { "utilisateur": "Utilisateur", "methode": "Méthode", "uri": "Route", "Value": "Appels" }
        } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Appels", "desc": true }] } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Appels" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }] }
      ] },
      "options": { "showHeader": true }
    }
  ]
}
