      <AdmWebSessions Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AdmWebSessions</Alias>
        <Columns isList="true" count="4">
          <value>AdmTierTitleCode,System.String</value>
          <value>AdmTierTitleDescription,System.String</value>
          <value>CfgTierViewDescription,System.String</value>
          <value>PKey,System.Guid</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>af78b3bcba924a25aa88b9463bccc2c5</Key>
        <Name>AdmWebSessions</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,SessionID,72,0</value>
        </Parameters>
        <SqlCommand>select
	AdmWebSessions.PKey
	, CfgTierView.AdmTierTitleCode
	, CfgTierView.AdmTierTitleDescription
	, CfgTierView.Description AS CfgTierViewDescription
	from AdmWebSessions
	LEFT OUTER JOIN AdmUser ON AdmWebSessions.UserId = AdmUser.PKey
LEFT OUTER JOIN CfgTierView ON AdmUser.CfgEmployeeId = CfgTierView.PKey
WHERE AdmWebSessions.PKey=?</SqlCommand>
      </AdmWebSessions>
      <ComSaleDocumentView Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ComSaleDocumentView</Alias>
        <Columns isList="true" count="20">
          <value>Amount,System.Decimal</value>
