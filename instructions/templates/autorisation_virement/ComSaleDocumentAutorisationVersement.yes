          <value>CfgTierAdmTierTitleDescription,System.String</value>
          <value>CfgTierDescription,System.String</value>
          <value>CfgTierFirstName,System.String</value>
          <value>CfgTierIDNumber,System.String</value>
          <value>CfgTierLastName,System.String</value>
          <value>CfgTrancheDescription,System.String</value>
          <value>PaymentAuthorizationDate,System.DateTime</value>
          <value>PKey,System.Guid</value>
          <value>Price,System.Decimal</value>
          <value>StkItemCode,System.String</value>
          <value>StlAccountCfgBankDescription,System.String</value>
          <value>StlAccountRIB,System.String</value>
          <value>StlSettlementTypeDescription,System.String</value>
          <value>WithdrawalDelay,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>0324a817d74043428ed2b4010fb3d7c0</Key>
        <Name>ComSaleDocumentView</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select 
	ComDocument.PKey
	, ComSaleDocumentView.CfgCompanyDescription
	, ComSaleDocumentView.CfgTrancheDescription
	, ComSaleDocumentView.StkItemCode
	, ComSaleFolderView.Price
	, ISNULL(StlSettlementType.Description,'') AS StlSettlementTypeDescription
	, ComSaleDocumentView.Amount
	, ComDocument.PaymentAuthorizationDate
	, ISNULL(StlAccountView.RIB,'') AS StlAccountRIB
	, ISNULL(StlAccountView.CfgBankDescription,'') AS StlAccountCfgBankDescription
	, CfgTranche.WithdrawalDelay
	, ISNULL(CfgTierView.AdmTierTitleCode,'') AS CfgTierAdmTierTitleCode
	, ISNULL(CfgTierView.AdmTierTitleDescription,'') AS CfgTierAdmTierTitleDescription
	, ISNULL(CfgTierView.FirstName,'') AS CfgTierFirstName
	, ISNULL(CfgTierView.LastName,'') AS CfgTierLastName
	, ISNULL(CfgTierView.Description,'') AS CfgTierDescription
	, ISNULL(CfgTierView.AdmIdentityDocumentTypeCode,'') AS CfgTierAdmIdentityDocumentTypeCode
	, ISNULL(CfgTierView.AdmIdentityDocumentTypeDescription,'') AS CfgTierAdmIdentityDocumentTypeDescription
	, ISNULL(CfgTierView.IDNumber,'') AS CfgTierIDNumber
	, ISNULL(CfgTierView.Address,'') AS CfgTierAddress
	from ComDocument
	INNER JOIN ComSaleDocumentView ON ComSaleDocumentView.PKey = ComDocument.PKey
INNER JOIN ComSaleFolderView ON ComSaleDocumentView.ComFolderId = ComSaleFolderView.PKey
INNER JOIN CfgTranche ON ComSaleDocumentView.CfgTrancheId = CfgTranche.PKey
LEFT OUTER JOIN StlSettlementType ON ComDocument.StlSettlementTypeId = StlSettlementType.PKey
LEFT OUTER JOIN StlAccountView ON ComDocument.StlAccountId = StlAccountView.PKey
LEFT OUTER JOIN CfgTierView ON ComDocument.CfgContactId = CfgTierView.PKey
WHERE ComSaleDocumentView.PKey=?</SqlCommand>
      </ComSaleDocumentView>
