  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class Report : Stimulsoft.Report.StiReport
    {
        public Report()        {
            this.InitializeComponent();
        }

		
		
		public const string frZero="zéro";
		public const string frOne = "un";
		public static string[] unite = {
			frZero, frOne,"deux","trois","quatre","cinq","six","sept","huit","neuf",
			"dix","onze","douze","treize","quatorze","quinze","seize","dix-sept","dix-huit","dix-neuf",
			"vingt","vingt et un","vingt deux","vingt trois","vingt quatre","vingt cinq","vingt six","vingt sept","vingt huit","vingt neuf",
			"trente","trente et un","trente deux","trente trois","trente quatre","trente cinq","trente six","trente sept","trente huit","trente neuf",
			"quarante","quarante et un","quarante deux","quarante trois","quarante quatre","quarante cinq","quarante six","quarante sept","quarante huit","quarante neuf",
			"cinquante","cinquante et un","cinquante deux","cinquante trois","cinquante quatre","cinquante cinq","cinquante six","cinquante sept","cinquante huit","cinquante neuf",
			"soixante","soixante et un","soixante deux","soixante trois","soixante quatre","soixante cinq","soixante six","soixante sept","soixante huit","soixante neuf",
			"soixante-dix","soixante-onze","soixante-douze","soixante-treize","soixante-quatorze","soixante-quinze","soixante-seize","soixante-dix-sept","soixante-dix-huit","soixante-dix-neuf",
			"quatre-vingts","quatre-vingt et un","quatre-vingt deux","quatre-vingt trois","quatre-vingt quatre","quatre-vingt cinq","quatre-vingt six","quatre-vingt sept","quatre-vingt huit","quatre-vingt neuf",
			"quatre-vingt-dix","quatre-vingt-onze","quatre-vingt-douze","quatre-vingt-treize","quatre-vingt-quatorze","quatre-vingt-quinze","quatre-vingt-seize","quatre-vingt-dix-sept","quatre-vingt-dix-huit","quatre-vingt-dix-neuf"
			};
			
		public static string DecimalToLiteral(decimal imputDecimal,string currencyLabel,string currencyFraction)
		{
			string returnString;
			string returnSubString;
			imputDecimal=decimal.Round(imputDecimal,2);
			returnString = IntegerToLiteral(decimal.ToInt64(imputDecimal));
			returnSubString = IntegerToLiteral(decimal.ToInt64((imputDecimal%1M)*100));
			// Cas de l'existance de la partie décimale
			if(imputDecimal%1M!=0M)
			{
				returnString = returnString.Trim() + " " + ((returnString == frOne || returnString == frZero) ? currencyLabel : currencyLabel+"s")
					+ " " + returnSubString.Trim() + " " + ((returnString == frOne || returnString == frZero) ? currencyFraction : currencyFraction+"s");
			}
				// Cas de d'abscence de la partie décimale
			else
			{
				returnString = returnString.Trim() + " " + ((returnString == frOne) ? currencyLabel : currencyLabel + "s");
			}	
			return(returnString);
		}

		public static string IntegerToLiteral(long inputInteger)
		{
			string returnString=string.Empty;
			
			if (inputInteger==0){return frZero;}

			long les_centaines=decimal.ToInt64(inputInteger/100);
			//long les_dizaines=decimal.ToInt64((inputInteger-les_centaines*100)/10);
			//long lunite=decimal.ToInt64(inputInteger-les_centaines*100-les_dizaines*10);
			long lunite=decimal.ToInt64(inputInteger-les_centaines*100);

			// Calcul
			if(inputInteger&lt;1000) 
			{
				returnString+=unite[lunite];
				// pour les centaines :
				if (les_centaines&gt;1) 
				{
					// cas des centaines tout rond
					if (returnString==frZero)
					{
						returnString=unite[les_centaines]+" cents ";
					} 
					else 
					{
						returnString=unite[les_centaines]+" cent "+returnString;
					}
				} 
				else if (les_centaines==1) 
				{
					if (returnString==frZero)
					{
						returnString=string.Empty;
					}
					returnString="cent "+returnString;
				}
			} 
			else if (inputInteger&lt;1000000000000000) 
			{
				// Cela couvre largement les nombres classiques. 
				System.Collections.ArrayList bloc = new System.Collections.ArrayList();
				while(inputInteger&gt;0) 
				{
					long milliers=Decimal.ToInt64(inputInteger/1000);
					long mille=inputInteger-milliers*1000;
					bloc.Add(mille);
					inputInteger=Decimal.ToInt64((inputInteger-mille)/1000);
				}
				string[] titres={string.Empty, "mille","million","milliard","billion","trillion"};
				long i=0;
				foreach(long b in bloc) 
				{
					string s="s";
					string rc = IntegerToLiteral(b);
					string t = titres[i];
					if (rc!=frZero) 
					{
						if(rc==frOne) 
						{
							if(t=="mille")
							{
								rc=string.Empty;
							} 
						}
						if((t==string.Empty || t=="mille") || (rc==frOne))
						{
							s=string.Empty;
						} 
						returnString=rc+" "+t+s+" "+returnString;
					}
					i++;
				}
			}	
			return returnString;
		}
		
			
		
		
		
		
		
		
		
		
		
		
		
		
		
        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}
</Script>
