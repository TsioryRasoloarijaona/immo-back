      <Customers Ref="7" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>Customers</Alias>
        <Columns isList="true" count="12">
          <value>AdmTierTitleCode,System.String</value>
          <value>AdmTierTitleDescription,System.String</value>
          <value>CfgTierAddress,System.String</value>
          <value>CfgTierDescription,System.String</value>
          <value>CfgTierIDNumber,System.String</value>
          <value>CfgTierIDTypeCode,System.String</value>
          <value>CfgTierIDTypeDescription,System.String</value>
          <value>CfgTierMobile,System.String</value>
          <value>ComDocumentId,System.Guid</value>
          <value>PartPercent,System.Decimal</value>
          <value>PKey,System.Guid</value>
          <value>Sorting,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>aadbf71a30be4701aa515f8bd1e19ab0</Key>
        <Name>Customers</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT * FROM (
Select 
	CfgTierView.PKey
	, 0 AS Sorting
	, CfgTierView.AdmTierTitleCode
	, CfgTierView.AdmTierTitleDescription
	, CfgTierView.Description As CfgTierDescription
	, CfgTierView.AdmIdentityDocumentTypeCode AS CfgTierIDTypeCode
	, CfgTierView.AdmIdentityDocumentTypeDescription AS CfgTierIDTypeDescription
	, CfgTierView.IDNumber AS CfgTierIDNumber
	, CfgTierView.Address AS CfgTierAddress
	, CfgTierView.Mobile AS CfgTierMobile
	, ComFolder.PartPercent
	, ComDocument.PKey AS ComDocumentId
	From ComDocument
	INNER JOIN ComFolder ON ComDocument.ComFolderId = ComFolder.PKey
	INNER JOIN CfgTierView ON ComFolder.CfgCustomerId = CfgTierView.PKey
UNION ALL
Select 
	ComFolderCustomer.PKey
	, 1 AS Sorting
	, CfgTierView.AdmTierTitleCode
	, CfgTierView.AdmTierTitleDescription
	, CfgTierView.Description As CfgTierDescription
	, CfgTierView.AdmIdentityDocumentTypeCode AS CfgTierIDTypeCode
	, CfgTierView.AdmIdentityDocumentTypeDescription AS CfgTierIDTypeDescription
	, CfgTierView.IDNumber AS CfgTierIDNumber
	, CfgTierView.Address AS CfgTierAddress
	, CfgTierView.Mobile AS CfgTierMobile
	, ComFolderCustomer.PartPercent
	, ComDocument.Pkey As ComDocumentId
	From ComFolderCustomer
	INNER JOIN ComFolder ON ComFolderCustomer.ComFolderId = ComFolder.PKey
	INNER JOIN ComDocument ON ComDocument.ComFolderId = ComFolder.PKey
	INNER JOIN CfgTierView ON ComFolderCustomer.CfgTierId = CfgTierView.PKey
) AS Customers
WHERE Customers.ComDocumentId = ?
ORDER BY Customers.Sorting, Customers.PartPercent desc</SqlCommand>
      </Customers>
