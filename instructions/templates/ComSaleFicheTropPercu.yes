	ROW_NUMBER() OVER ( ORDER BY CfgTierView.PKey ) AS RowNum
, CfgTierView.*
, ComFolderCustomer.PartPercent
, ComFolder.PKey AS ComFolderId
FROM ComDocument INNER JOIN
StlSettlementLine ON ComDocument.PKey = StlSettlementLine.ComDocumentId INNER JOIN
ComFolder ON ComDocument.ComFolderId = ComFolder.PKey INNER JOIN
ComFolderCustomer ON ComFolder.PKey = ComFolderCustomer.ComFolderId INNER JOIN
CfgTierView ON ComFolderCustomer.CfgTierId = CfgTierView.PKey
WHERE ComDocument.ComFolderId=?
) AS TT
WHERE TT.RowNum=1
ORDER BY RowNum</SqlCommand>
      </CfgTier1>
