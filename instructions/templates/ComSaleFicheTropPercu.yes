              <Page isRef="24" />
              <Parent isRef="29" />
              <Text>Nous soussignés socièté {ComFolder.Item.Nom.SocialReason} {ComFolder.Item.Nom.LegalForm} dont le siège social est à {ComFolder.Item.Nom.Address}, reconnaissons avoir reçu de {ComFolder.Customer.Title} {ComFolder.Customer.Description} , {ComFolder.Customer.IdentityDocumentType} N° {ComFolder.Customer.IDNumber}{IIF(string.IsNullOrEmpty(ComFolder.Customer1.Description),""," et de " + ComFolder.Customer1.Title + " " + ComFolder.Customer1.Description + ", " + ComFolder.Customer1.IdentityDocumentType + " N° " + ComFolder.Customer1.IDNumber)}{IIF(string.IsNullOrEmpty(ComFolder.Customer2.Description),""," et de " + ComFolder.Customer2.Title + " " + ComFolder.Customer2.Description + ", " + ComFolder.Customer2.IdentityDocumentType + " N° " + ComFolder.Customer2.IDNumber)}, un trop perçu de {Format("{0:C}", Abs(StkSaleFolderView.TropPercu))} ({DecimalToLiteral(Abs(StkSaleFolderView.TropPercu),CurrencyLabel.CodeValue,CurrencyFraction.CodeValue)}) sur l'acquisition de : </Text>
              <TextBrush>Black</TextBrush>
              <TextOptions>,,,,WordWrap=True,A=0</TextOptions>
              <TextQuality>Wysiwyg</TextQuality>
              <Type>Expression</Type>
            </Text2>
