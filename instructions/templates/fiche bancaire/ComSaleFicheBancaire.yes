        <Name>CfgTier5</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>P1,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT * FROM (
SELECT 
	ROW_NUMBER() OVER ( ORDER BY CfgTier.PKey ) AS RowNum
, CfgTier.*
, AdmProfession.Description AS AdmProfessionDescription
, AdmCountry.Description AS AdmCountryDescription
, AdmIdentityDocumentType.Code AS AdmIdentityDocumentTypeCode
, AdmFamilySituation.Description AS AdmFamilySituationDescription
, ComFolderCustomer.PartPercent
FROM ComFolderCustomer 
INNER JOIN ComFolder ON ComFolderCustomer.ComFolderId = ComFolder.PKey 
INNER JOIN CfgTier ON ComFolderCustomer.CfgTierId = CfgTier.PKey
LEFT OUTER JOIN AdmFamilySituation ON CfgTier.AdmFamilySituationId = AdmFamilySituation.PKey 
LEFT OUTER JOIN AdmIdentityDocumentType ON CfgTier.AdmIdentityDocumentTypeId = AdmIdentityDocumentType.PKey 
LEFT OUTER JOIN AdmCountry ON CfgTier.AdmCountryId = AdmCountry.PKey 
LEFT OUTER JOIN AdmProfession ON CfgTier.AdmProfessionId = AdmProfession.PKey
WHERE ComFolder.PKey=?
) AS TT
WHERE TT.RowNum=4
ORDER BY RowNum


</SqlCommand>
