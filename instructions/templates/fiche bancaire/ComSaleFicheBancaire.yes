        <Dictionary isRef="1" />
        <Key>3e653bb0132740ba8281cdccf99e2e20</Key>
        <Name>CfgTier1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT        
CfgTier.*
, AdmProfession.Description AS AdmProfessionDescription
, AdmCountry.Description AS AdmCountryDescription
, AdmIdentityDocumentType.Code AS AdmIdentityDocumentTypeCode
, AdmFamilySituation.Description AS AdmFamilySituationDescription
FROM ComFolder INNER JOIN
CfgTier ON ComFolder.CfgCustomerId = CfgTier.PKey LEFT OUTER JOIN
AdmFamilySituation ON CfgTier.AdmFamilySituationId = AdmFamilySituation.PKey LEFT OUTER JOIN
AdmIdentityDocumentType ON CfgTier.AdmIdentityDocumentTypeId = AdmIdentityDocumentType.PKey LEFT OUTER JOIN
AdmCountry ON CfgTier.AdmCountryId = AdmCountry.PKey LEFT OUTER JOIN
AdmProfession ON CfgTier.AdmProfessionId = AdmProfession.PKey
WHERE ComFolder.PKey = ?</SqlCommand>
      </CfgTier1>
