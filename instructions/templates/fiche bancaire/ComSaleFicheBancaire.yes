        <Name>UnderItemArea</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT SUM(StkItemUnder.Area) AS AreaUnderSum
	FROM ComFolder 
	INNER JOIN StkItem ON ComFolder.StkItemId = StkItem.PKey  
INNER JOIN StkItem AS StkItemUnder ON StkItemUnder.ParentId = StkItem.PKey
WHERE  ComFolder.PKey=?</SqlCommand>
      </UnderItemArea>
