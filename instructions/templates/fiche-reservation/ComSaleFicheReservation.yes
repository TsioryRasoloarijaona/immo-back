          <value>CfgTierViewAddress,System.String</value>
          <value>CfgTierViewDescription,System.String</value>
          <value>CfgTierViewIDNumber,System.String</value>
          <value>ComFolderCode,System.String</value>
          <value>PKey,System.Guid</value>
          <value>PriceAfterDiscount,System.Decimal</value>
          <value>StkBuildingCode,System.String</value>
          <value>StkBuildingDescription,System.String</value>
          <value>StkFloorCode,System.String</value>
          <value>StkFloorDescription,System.String</value>
          <value>StkFloorSorting,System.Int32</value>
          <value>StkItemViewCode,System.String</value>
          <value>StkItemViewDescription,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>4283a48714ec406a9f0447d7e796b653</Key>
        <Name>ComFolder</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select
ComFolder.PKey
, ComFolder.Code AS  ComFolderCode
, ComFolder.PriceAfterDiscount AS PriceAfterDiscount

, CfgTierView.Description AS CfgTierViewDescription
, CfgTierView.Address AS CfgTierViewAddress
, CfgTierView.IDNumber AS CfgTierViewIDNumber

, StkItemView.CfgProjectCode
	
, StkItemView.Code AS StkItemViewCode
, StkItemView.Description AS StkItemViewDescription
, StkItemView.StkBuildingCode
, StkItemView.StkBuildingDescription
, StkItemView.StkFloorSorting
, StkItemView.StkFloorCode
, StkItemView.StkFloorDescription
, StkItemView.Area

FROM
ComFolder
INNER JOIN CfgTierView ON ComFolder.CfgCustomerId = CfgTierView.PKey
INNER JOIN StkItemView ON ComFolder.StkItemId = StkItemView.PKey
WHERE ComFolder.PKey=?</SqlCommand>
      </ComFolder>
      <StlSettlement Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>StlSettlement</Alias>
        <Columns isList="true" count="10">
          <value>ComDocumentAmountTTC,System.Decimal</value>
          <value>ComSettlementCategoryDescription,System.String</value>
          <value>CustomerDescription,System.String</value>
          <value>PayerDescription,System.String</value>
          <value>PKey,System.Guid</value>
          <value>StlSettlementAmount,System.Decimal</value>
          <value>StlSettlementDescription,System.String</value>
          <value>StlSettlementDocDate,System.DateTime</value>
          <value>StlSettlementLineAmount,System.Decimal</value>
          <value>StlSettlementTypeDescription,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>35b6f8b07724414a8ce75b42d80a431e</Key>
        <Name>StlSettlement</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select TOP(1)
StlSettlement.PKey
, StlSettlement.Description AS StlSettlementDescription
, StlSettlement.Amount AS StlSettlementAmount
, StlSettlementLine.Amount AS StlSettlementLineAmount
, StlSettlementType.Description AS StlSettlementTypeDescription
, StlSettlement.DocDate AS StlSettlementDocDate
, ComDocument.AmountTTC  AS ComDocumentAmountTTC
, ComSettlementCategory.Description AS ComSettlementCategoryDescription
, Customer.Description AS CustomerDescription
, Payer.Description AS PayerDescription
from StlSettlement -- Les pièces de réglement
INNER JOIN CfgTier AS Customer ON StlSettlement.TierId = Customer.PKey -- Client
INNER JOIN CfgTier AS Payer ON StlSettlement.TierPayerId = Payer.PKey -- Payeur
INNER JOIN StlSettlementType ON StlSettlement.StlSettlementTypeId = StlSettlementType.PKey -- Type de pièce de réglement
INNER JOIN StlSettlementLine ON StlSettlementLine.StlSettlementId = StlSettlement.PKey -- Les affectation d'une pièce de réglement
INNER JOIN ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey -- Les échéance d'un dossier de vente
INNER JOIN ComSettlementCategory ON ComDocument.ComSettlementCategoryId = ComSettlementCategory.PKey -- Catégorie des échéance d'un dossier de vente
INNER JOIN ComFolder ON ComDocument.ComFolderId = ComFolder.PKey -- Dossier de vente
WHERE 
(ComSettlementCategory.IsSaleAdvance=1 OR ComSettlementCategory.IsSaleCredit=1 OR ComSettlementCategory.IsSaleAutoFinancment=1)
AND ComFolder.PKey=?
ORDER BY StlSettlement.DocDate ASC
</SqlCommand>
      </StlSettlement>
