      <AmountWithoutFees Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AmountWithoutFees</Alias>
        <Columns isList="true" count="2">
          <value>StlSettlementIsCredit,System.Boolean</value>
          <value>StlSettlementLineAmount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>40bf6087833141b09674e0ec67021c37</Key>
        <Name>AmountWithoutFees</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT        
	StlSettlementLine.Amount AS StlSettlementLineAmount
	, StlSettlement.IsCredit AS StlSettlementIsCredit
	FROM StlSettlementLine INNER JOIN
	StlSettlement ON StlSettlementLine.StlSettlementId = StlSettlement.PKey INNER JOIN
ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey INNER JOIN 
ComSettlementCategory ON ComSettlementCategory.PKey = ComDocument.ComSettlementCategoryId
WHERE ComDocument.ComFolderId IN(SELECT         ComDocument.ComFolderId
	FROM StlSettlementLine  INNER JOIN
	ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
WHERE StlSettlementLine.StlSettlementId=?)
</SqlCommand>
      </AmountWithoutFees>
