      <FolderLines Ref="16" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FolderLines</Alias>
        <Columns isList="true" count="8">
          <value>Amount,System.Decimal</value>
          <value>ComFolderId,System.Guid</value>
          <value>Description,System.String</value>
          <value>DocDate,System.DateTime</value>
          <value>Status,System.String</value>
          <value>StlSettlementId,System.Guid</value>
          <value>StlSettlementIsCredit,System.Boolean</value>
          <value>StlSettlementLineAmount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>4080c16220e24c4d862ad3f2a6819764</Key>
        <Name>FolderLines</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT        
	StlSettlement.DocDate
	, StlSettlement.Description
	, StlSettlement.Amount
	, StlSettlementLine.Amount AS StlSettlementLineAmount
	, StlSettlement.PKey AS StlSettlementId
	, StlSettlement.IsCredit AS StlSettlementIsCredit
	, StlSettlement.Status
	, ComDocument.ComFolderId
	FROM StlSettlementLine  INNER JOIN
	StlSettlement ON StlSettlementLine.StlSettlementId = StlSettlement.PKey INNER JOIN
ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
WHERE ComDocument.ComFolderId IN
(SELECT ComDocument.ComFolderId
	FROM StlSettlementLine
	INNER JOIN ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
WHERE StlSettlementLine.StlSettlementId=?)</SqlCommand>
      </FolderLines>
      <RntDocumentView Ref="17" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>RntDocumentView</Alias>
        <Columns isList="true" count="7">
          <value>AmountSettled,System.Decimal</value>
          <value>AmountToPay,System.Decimal</value>
          <value>CfgTierDescription,System.String</value>
          <value>Code,System.String</value>
          <value>PeriodDescription,System.String</value>
          <value>PKey,System.Guid</value>
          <value>StkItemCode,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>78d2389cca02499aa8ad66c18c04f81f</Key>
        <Name>RntDocumentView</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="2">
          <value>Parameter1,MainID,72,0</value>
          <value>Parameter2,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select
	RntDocumentView.PKey
	, RntDocumentView.CfgTierDescription
	, RntDocumentView.StkItemCode
	, RntDocumentView.PeriodDescription
	, RntDocumentView.AmountToPay
	, StlSettlementLine.Amount as AmountSettled
	, '' as Code
	from
	RntDocumentView
	inner join StlSettlementLine on StlSettlementLine.RntDocumentId = RntDocumentView.PKey
where StlSettlementLine.StlSettlementId = ?

union all

select
	RntDocumentView.PKey
	, RntDocumentView.CfgTierDescription
	, RntDocumentView.StkItemCode
	, RntDocumentView.PeriodDescription
	, RntDocumentView.AmountToPay
	, IIF(StlDocument.AmountTTC=0, 0, (StlSettlementLine.Amount * (StlDocumentLine.TotalTTC / StlDocument.AmountTTC))) as AmountSettled
	, StlDocument.Code
	from
	RntDocumentView
	inner join StlDocumentLine on StlDocumentLine.RntDocumentId = RntDocumentView.PKey
inner join StlDocument ON StlDocumentLine.StlDocumentId = StlDocument.PKey
inner join StlSettlementLine on StlSettlementLine.StlDocumentId = StlDocument.PKey
where StlSettlementLine.StlSettlementId = ?
</SqlCommand>
      </RntDocumentView>
