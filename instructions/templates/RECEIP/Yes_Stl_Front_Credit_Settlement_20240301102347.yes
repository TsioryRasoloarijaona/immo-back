        <Dictionary isRef="1" />
        <Key>182dc9c9b49b47758dacbb8e6ce39b3b</Key>
        <Name>StlSettlementView</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Parameter,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select 
	StlSettlementView.*

	, CfgComPanyView.LegalForm AS CfgComPanyViewLegalForm
, CfgComPanyView.MainAddress AS CfgComPanyViewAddress
, CfgComPanyView.SignatureCity AS CfgComPanySignatureCity
, CfgComPanyView.Address AS CfgCompanyAddress
, CfgComPanyView.Address2 AS CfgCompanyAddress2
, CfgComPanyView.Address3 AS CfgCompanyAddress3
, CfgComPanyView.City AS CfgCompanyCity
, CfgComPanyView.ZipCode AS CfgCompanyZipCode
, CfgComPanyView.FiscalNumber AS CfgCompanyFiscalNumber
, CfgComPanyView.Phone AS CfgCompanyPhone
, CfgComPanyView.Fax AS CfgCompanyFax
, (select AdmAttachedFile.AttachedFile from AdmAttachedFile
	INNER JOIN AdmAttachedFileType ON AdmAttachedFile.AdmAttachedFileTypeId = AdmAttachedFileType.PKey
	WHERE AdmAttachedFileType.Code='LOGO' AND AdmAttachedFile.CategoryId=CfgComPanyView.PKey
	) AS CfgCompanyLogo

, ISNULL(CfgTier.Title,'') AS Title
, ISNULL(CfgTier.IdentityDocumentType,'') AS IdentityDocumentType
, ISNULL(CfgTier.IDNumber,'') AS IDNumber

, StlSettlementView.TierId AS CfgTierId
, ISNULL(CfgTier.Title,'') AS CfgTierTitle
, ISNULL(CfgTier.Address,'') AS CfgTierAddress
, CfgTier.BirthDate AS CfgTierBirthDate
, ISNULL(CfgTier.BirthPlace,'') AS CfgTierBirthPlace
, ISNULL(CfgTier.Nationality,'') AS CfgTierNationality
, ISNULL(CfgTier.IDDescription,'') AS CfgTierIDDescription
, ISNULL(CfgTier.IdentityDocumentType,'') AS CfgTierIDType
, ISNULL(CfgTier.IDNumber,'') AS CfgTierIDNumber
, CfgTier.IDDate AS CfgTierIDDate
, CfgTier.SocialFormIsPerson AS CfgTierIsPerson
, ISNULL(CfgTier.FiscalCode,'') AS CfgTierFiscalCode
, ISNULL(CfgTier.FiscalRegistry,'') AS CfgTierFiscalRegistry
, StlSettlementView.TierPayerId AS CfgPayerId
, ISNULL(CfgPayer.Title,'') AS CfgPayerTitle
, ISNULL(CfgPayer.Description,'') AS CfgPayerDescription
, ISNULL(CfgPayer.Address,'') AS CfgPayerAddress
, CfgPayer.BirthDate AS CfgPayerBirthDate
, ISNULL(CfgPayer.BirthPlace,'') AS CfgPayerBirthPlace
, ISNULL(CfgPayer.Nationality,'') AS CfgPayerNationality
, ISNULL(CfgPayer.IDDescription,'') AS CfgPayerIDDescription
, ISNULL(CfgPayer.IdentityDocumentType,'') AS CfgPayerIDType
, ISNULL(CfgPayer.IDNumber,'') AS CfgPayerIDNumber
, CfgPayer.IDDate AS CfgPayerIDDate
, CfgPayer.SocialFormIsPerson AS CfgPayerIsPerson
, ISNULL(CfgPayer.FiscalCode,'') AS CfgPayerFiscalCode
, ISNULL(CfgPayer.FiscalRegistry,'') AS CfgPayerFiscalRegistry

,LTRIM(RTRIM(ISNULL((SELECT STUFF((SELECT DISTINCT + ', ' + Description
	FROM (
select StlSettlementAffectationView.StlCategoryDescription AS Description from StlSettlementAffectationView
	WHERE StlSettlementAffectationView.StlSettlementId = StlSettlementView.PKey
	)AS Test FOR XML PATH ('')),1,1,'')), ''))) AS CategoryDescription

,LTRIM(RTRIM(ISNULL((SELECT STUFF((SELECT DISTINCT + ', ' + Description
	FROM (
select StlSettlementAffectationView.StkItemDescription AS Description from StlSettlementAffectationView
	WHERE StlSettlementAffectationView.StlSettlementId = StlSettlementView.PKey
	)AS Test FOR XML PATH ('')),1,1,'')), ''))) AS StkItemDescription

,LTRIM(RTRIM(ISNULL((SELECT STUFF((SELECT DISTINCT + ', ' + Description
	FROM (
select StlSettlementAffectationView.CfgProjectDescription AS Description from StlSettlementAffectationView
	WHERE StlSettlementAffectationView.StlSettlementId = StlSettlementView.PKey
	)AS Test FOR XML PATH ('')),1,1,'')), ''))) AS ProjectDescription

,LTRIM(RTRIM(ISNULL((SELECT STUFF((SELECT DISTINCT + ', ' + Description
	FROM (
select StlSettlementAffectationView.CfgTrancheDescription AS Description from StlSettlementAffectationView
	WHERE StlSettlementAffectationView.StlSettlementId = StlSettlementView.PKey
	)AS Test FOR XML PATH ('')),1,1,'')), ''))) AS TrancheDescription

from StlSettlementView
INNER JOIN CfgCompanyView ON StlSettlementView.CfgCompanyId = CfgCompanyView.PKey
LEFT OUTER JOIN CfgTierView AS CfgTier  ON StlSettlementView.TierId = CfgTier.PKey
LEFT OUTER JOIN CfgTierView AS CfgPayer ON StlSettlementView.TierPayerId = CfgPayer.PKey
WHERE StlSettlementView.PKey = ?</SqlCommand>
      </StlSettlementView>
      <UnderItems Ref="22" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>UnderItems</Alias>
        <Columns isList="true" count="7">
          <value>Area,System.Decimal</value>
          <value>Code,System.String</value>
          <value>ComFolderId,System.Guid</value>
          <value>ComSettlementId,System.Guid</value>
          <value>Price,System.Decimal</value>
          <value>StkItemCategoryCode,System.String</value>
          <value>StkItemCategoryDescription,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>54fb269783ab46cda76e8946bd5c122d</Key>
        <Name>UnderItems</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT   
	StlSettlementLine.StlSettlementId 
	, StkItem.Code
	, ComFolderItem.Area
	, ComFolderItem.ComFolderId
	, StkItemCategory.Code AS StkItemCategoryCode
	, StkItemCategory.Description AS StkItemCategoryDescription
	, ComFolderItem.Price
	FROM ComFolderItem 
	INNER JOIN StkItem ON ComFolderItem.StkItemId = StkItem.PKey 
INNER JOIN StkItemCategory ON ComFolderItem.StkItemCategoryId = StkItemCategory.PKey 
INNER JOIN ComFolder ON ComFolderItem.ComFolderId = ComFolder.PKey 
INNER JOIN ComDocument ON ComFolder.PKey = ComDocument.ComFolderId 
INNER JOIN StlSettlementLine ON ComDocument.PKey = StlSettlementLine.ComDocumentId
WHERE StlSettlementLine.StlSettlementId = ?</SqlCommand>
      </UnderItems>
