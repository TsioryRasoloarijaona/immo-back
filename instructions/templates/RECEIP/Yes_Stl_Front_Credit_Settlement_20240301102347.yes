      <StlSettlementLine Ref="20" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>StlSettlementLine</Alias>
        <Columns isList="true" count="6">
          <value>Amount,System.Decimal</value>
          <value>CfgCustomerDescription,System.String</value>
          <value>CfgCustomerIdentityDocumentType,System.String</value>
          <value>CfgCustomerIDNumber,System.String</value>
          <value>CfgCustomerTierTitle,System.String</value>
          <value>ComFolderId,System.Guid</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>9586b83a590f4ca39d49232d0718f082</Key>
        <Name>StlSettlementLine</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT
	SUM(StlSettlementLine.Amount) AS Amount
	,ComDocument.ComFolderId
	, CfgTier.Description AS CfgCustomerDescription
	, CfgTier.IDNumber AS CfgCustomerIDNumber
	, AdmIdentityDocumentType.Description AS CfgCustomerIdentityDocumentType
	, AdmTierTitle.Description as CfgCustomerTierTitle
	FROM StlSettlementLine 
	INNER JOIN StlSettlement ON StlSettlementLine.StlSettlementId = StlSettlement.PKey 
INNER JOIN ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
INNER JOIN ComFolder ON ComFolder.PKey = ComDocument.ComFolderId 
LEFT OUTER JOIN CfgTier ON ComFolder.CfgCustomerId = CfgTier.PKey
LEFT OUTER JOIN AdmIdentityDocumentType on CfgTier.AdmIdentityDocumentTypeId = AdmIdentityDocumentType.PKey
LEFT OUTER JOIN AdmTierTitle ON CfgTier.AdmTierTitleId = AdmTierTitle.PKey
WHERE StlSettlement.PKey=?
Group by 
ComDocument.ComFolderId,CfgTier.Description,CfgTier.IDNumber,AdmIdentityDocumentType.Description,AdmTierTitle.Description

</SqlCommand>
      </StlSettlementLine>
