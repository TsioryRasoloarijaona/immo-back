      <ComSettlementFolder Ref="13" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ComSettlementFolder</Alias>
        <Columns isList="true" count="14">
          <value>Amount,System.Decimal</value>
          <value>CfgBankId,System.Guid</value>
          <value>Code,System.String</value>
          <value>ComFolderCode,System.String</value>
          <value>ComFolderId,System.Guid</value>
          <value>Description,System.String</value>
          <value>DocDate,System.DateTime</value>
          <value>EcheanceDate,System.DateTime</value>
          <value>PKey,System.Guid</value>
          <value>ReceiptCode,System.String</value>
          <value>SettlementDate,System.DateTime</value>
          <value>StlSettlementId,System.Guid</value>
          <value>StlSettlementTypeId,System.Guid</value>
          <value>TierId,System.Guid</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>a0e53bdefae244f08d6d90ff4a19cb9b</Key>
        <Name>ComSettlementFolder</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT
	StlSettlement.PKey
	, StlSettlement.DocDate
	, StlSettlement.EcheanceDate
	, StlSettlement.SettlementDate
	, StlSettlement.Code
	, StlSettlement.Description
	, StlSettlement.ReceiptCode
	, StlSettlement.CfgBankId
	, StlSettlement.Amount
	, StlSettlement.StlSettlementTypeId
	, StlSettlement.TierId
	, StlSettlement.PKey AS StlSettlementId
	, ComFolder.PKey AS ComFolderId
	, ComFolder.Code AS ComFolderCode
	FROM ComDocument 
	INNER JOIN StlSettlementLine ON ComDocument.PKey = StlSettlementLine.ComDocumentId 
INNER JOIN ComFolder ON ComDocument.ComFolderId = ComFolder.PKey 
INNER JOIN StlSettlement ON StlSettlementLine.StlSettlementId = StlSettlement.PKey 
WHERE StlSettlement.PKey = ?</SqlCommand>
      </ComSettlementFolder>
