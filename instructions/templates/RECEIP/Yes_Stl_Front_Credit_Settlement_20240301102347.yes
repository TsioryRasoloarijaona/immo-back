      <CfgTranche Ref="8" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>CfgTranche</Alias>
        <Columns isList="true" count="1">
          <value>SyndicPeriod,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>39895f542ebf4ed19b8923191cd779b2</Key>
        <Name>CfgTranche</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select CfgTranche.SyndicPeriod from CfgTranche INNER JOIN
	StkItem ON StkItem.StkHierarchyId = CfgTranche.PKey INNER JOIN
ComFolder ON ComFolder.StkItemId = StkItem.PKey INNER JOIN
ComDocument ON ComFolder.PKey = ComDocument.ComFolderId INNER JOIN
StlSettlementLine ON ComDocument.PKey = StlSettlementLine.ComDocumentId
WHERE StlSettlementLine.StlSettlementId = ?</SqlCommand>
      </CfgTranche>
      <ComDocumentExpenses Ref="9" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ComDocumentExpenses</Alias>
        <Columns isList="true" count="6">
          <value>Amount,System.Decimal</value>
          <value>ComFolderId,System.Guid</value>
          <value>ComSettlementCategoryCode,System.String</value>
          <value>ComSettlementCategoryDescription,System.String</value>
          <value>DocDate,System.DateTime</value>
          <value>PKey,System.Guid</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>7c2d3d48bd594b48a790beed4071fe2a</Key>
        <Name>ComDocumentExpenses</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select 
	ComDocument.PKey
	, ComDocument.DocDate
	, ComDocument.ComFolderId
	, ComDocument.Amount 
	, ComSettlementCategory.Code AS ComSettlementCategoryCode
	, ComSettlementCategory.Description AS ComSettlementCategoryDescription
	from ComDocument
	INNER JOIN ComSettlementCategory ON ComDocument.ComSettlementCategoryId = ComSettlementCategory.PKey
WHERE 
ComSettlementCategory.IsSaleExpense = 1 
AND ComSettlementCategory.IsCredit = 1
AND ComDocument.ComFolderId 
IN(
SELECT ComDocument.ComFolderId
	FROM StlSettlementLine 
	INNER JOIN ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
	WHERE StlSettlementLine.StlSettlementId=?
)</SqlCommand>
      </ComDocumentExpenses>
