      <StlSettlementLine Ref="8" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>StlSettlementLine</Alias>
        <Columns isList="true" count="8">
          <value>Description,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>StlSettlementAmount,System.Decimal</value>
          <value>IsCredit,System.Boolean</value>
          <value>PKey,System.Guid</value>
          <value>ComDocumentId,System.Guid</value>
          <value>Notes,System.String</value>
          <value>DocDate,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>252c5f9f07eb45c2aa273599862cd2e1</Key>
        <Name>StlSettlementLine</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select 
StlSettlement.Description
, StlSettlementLine.Amount * (CASE WHEN StlSettlement.IsCredit = 1 THEN 1 ELSE -1 END) AS Amount
, StlSettlement.Amount AS StlSettlementAmount
, StlSettlement.IsCredit
, StlSettlement.Notes
, StlSettlement.DocDate
, StlSettlementLine.PKey
, StlSettlementLine.ComDocumentId
from StlSettlementLine
INNER JOIN StlSettlement ON StlSettlementLine.StlSettlementId = StlSettlement.PKey
INNER JOIN ComDocument ON StlSettlementLine.ComDocumentId = ComDocument.PKey
WHERE ComDocument.ComFolderId = ?</SqlCommand>
      </StlSettlementLine>
