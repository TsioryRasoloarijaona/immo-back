        <Dictionary isRef="1" />
        <Key>b58faa3de6f940fca3a5b2f68d4e7c5e</Key>
        <Name>ComFolderItem</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>select 
ComFolderItem.* 
, StkItemCategory.Code AS StkItemCategoryCode
, StkItemCategory.Description AS StkItemCategoryDescription
from ComFolderItem
LEFT OUTER JOIN StkItemCategory ON ComFolderItem.StkItemCategoryId = StkItemCategory.PKey
where ComFolderId = ?</SqlCommand>
      </ComFolderItem>
