      <Historique Ref="10" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>Historique</Alias>
        <Columns isList="true" count="8">
          <value>DocDate,System.DateTime</value>
          <value>PKey,System.Guid</value>
          <value>StatusDescription,System.String</value>
          <value>FolderCode,System.String</value>
          <value>UserDescription,System.String</value>
          <value>ItemDescription,System.String</value>
          <value>TierDescription,System.String</value>
          <value>Detail,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>38f87cdc69ec458899d0ef49e449677c</Key>
        <Name>Historique</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>Paramètre,MainID,72,0</value>
        </Parameters>
        <SqlCommand>SELECT
StrFolderStatusHistory.DocDate
, StrFolderStatusHistory.PKey
, StrSaleFolderStatus.Description AS StatusDescription
, ComFolder.Code AS FolderCode
, AdmUser.Description AS UserDescription
, StkItem.Code AS ItemDescription
, CfgTier.Description AS TierDescription
,CONCAT (ISNULL(ComSaleWithdrawalCancellation.Detail,''),ISNULL(ComSaleWithdrawalClient.Detail,''),ISNULL(ComSaleWithdrawalProduct.Detail,'')) AS Detail
FROM StrFolderStatusHistory 
LEFT OUTER JOIN StrStatus StrSaleFolderStatus ON StrFolderStatusHistory.StrFolderStatusId = StrSaleFolderStatus.PKey
LEFT OUTER JOIN AdmUser ON StrFolderStatusHistory.AdmUserId = AdmUser.PKey
LEFT OUTER JOIN ComFolder ON StrFolderStatusHistory.ComFolderId = ComFolder.PKey
LEFT OUTER JOIN StkItem ON StrFolderStatusHistory.StkItemId = StkItem.PKey
LEFT OUTER JOIN CfgTier ON StrFolderStatusHistory.CfgTierId = CfgTier.PKey
LEFT OUTER JOIN ComTierTransfertOperationView AS ComSaleWithdrawalCancellation ON StrFolderStatusHistory.ComSaleWithdrawalCancellationId = ComSaleWithdrawalCancellation.ComSaleWithdrawalCancellationId
LEFT OUTER JOIN ComTierTransfertOperationView AS ComSaleWithdrawalClient ON StrFolderStatusHistory.ComSaleWithdrawalClientId = ComSaleWithdrawalClient.ComSaleWithdrawalClientId
LEFT OUTER JOIN ComTierTransfertOperationView AS ComSaleWithdrawalProduct ON StrFolderStatusHistory.ComSaleWithdrawalProductId = ComSaleWithdrawalProduct.ComSaleWithdrawalProductId
WHERE StrFolderStatusHistory.ComFolderId=? 
ORDER BY StrFolderStatusHistory.DocDate
</SqlCommand>
      </Historique>
    </DataSources>
